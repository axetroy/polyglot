{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@polyglot-img/binary": ["./packages/binary/src"],
      "@polyglot-img/core": ["./packages/core/src"],
      "@polyglot-img/sdk": ["./packages/sdk/src"],
      "@polyglot-img/cli": ["./packages/cli/src"],
      "@polyglot-img/formats-png": ["./packages/formats/png/src"],
      "@polyglot-img/formats-jpeg": ["./packages/formats/jpeg/src"],
      "@polyglot-img/formats-zip": ["./packages/formats/zip/src"],
      "@polyglot-img/browser": ["./packages/browser/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/formats/*/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
