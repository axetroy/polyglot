{
  "name": "polyglot",
  "version": "0.1.0",
  "description": "Polyglot File Engine — combine image formats with archive data in a single file",
  "type": "module",
  "private": true,
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "packages/formats/*"
  ],
  "scripts": {
    "build": "npm run build -w @polyglot/binary -w @polyglot/formats-png -w @polyglot/formats-jpeg -w @polyglot/formats-zip -w @polyglot/core -w @polyglot/sdk -w @polyglot/cli -w @polyglot/browser",
    "build:watch": "npm run build -- --watch",
    "dev": "npm run test:watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/binary tests/zip",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "typecheck:all": "npm run typecheck",
    "clean": "find packages -name dist -type d -exec rm -rf {} + 2>/dev/null; rm -rf node_modules .turbo coverage .eslintcache",
    "prepare": "is-ci || husky install",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.0",
    "is-ci": "^3.0.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.0"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix --ext .ts",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
